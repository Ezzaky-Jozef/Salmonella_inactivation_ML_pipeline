        with publication_style_bw_minimalist():
            fig, ax = plt.subplots(figsize=(10, 7))
            feature_imp_df = pd.DataFrame({'Feature': X_train.columns, 'Importance': best_ml_model.feature_importances_}).sort_values('Importance', ascending=False)
            sns.barplot(x='Importance', y='Feature', data=feature_imp_df, color='lightgrey', edgecolor='black', ax=ax)
