# CELL 4: SECONDARY MODELING (BACKWARD STEPWISE REGRESSION)
# ==============================================================================

print("\n--- Running Secondary Modeling (Parameter Regression) ---")

if 'df_results_primary' in locals() and not df_results_primary.empty:
    env_factors = ["Oregano %", "NaCl %", "pH", "Temp °C"]
    df_primary_reg = df_results_primary.copy()
    for a, b in combinations(env_factors, 2):
        df_primary_reg[f"{a}*{b}"] = df_primary_reg[a] * df_primary_reg[b]

    def backward_stepwise(df, y_var, x_vars, alpha=0.05):
        X = sm.add_constant(df[x_vars])
        y = df[y_var]
        model = sm.OLS(y, X).fit()
        while True:
            pvals = model.pvalues.drop('const', errors='ignore')
            if pvals.empty: break
            worst_p = pvals.max()
            if worst_p > alpha:
                worst_var = pvals.idxmax()
                x_vars.remove(worst_var)
                X = sm.add_constant(df[x_vars])
                model = sm.OLS(y, X).fit()
            else:
                break
        return model, x_vars

    results_secondary = []
    predictors_full = env_factors + [f"{a}*{b}" for a, b in combinations(env_factors, 2)]
    param_cols_to_exclude = ["Run-ID", "Model", "RMSE", "AIC", "R2", "Bf", "Af"] + env_factors

    for model_name, g in df_primary_reg.groupby("Model"):
        param_cols = [c for c in g.columns if c not in param_cols_to_exclude and '*' not in c]
        for param in param_cols:
            df_sub = g.dropna(subset=[param])
            if len(df_sub) < len(predictors_full) + 2:
                print(f"  {model_name}-{param}: skipping regression, not enough data points.")
                continue
            try:
                model, kept_vars = backward_stepwise(df_sub, param, predictors_full.copy(), alpha=0.05)
                eq = f"{param} = {model.params.get('const', 0):+.3f} " + " ".join([f"{coef:+.3f}*[{v}]" for v, coef in model.params.items() if v != 'const'])
                results_secondary.append({
                    "Model": model_name, "Parameter": param, "Equation": eq,
                    "Adj_R2": model.rsquared_adj, "RMSE": np.sqrt(model.mse_resid),
                    "AIC": model.aic, "Predictors": ", ".join(kept_vars)
                })
            except Exception as e:
                print(f" {model_name}-{param}: regression failed ({e})")

    if results_secondary:
        df_secondary = pd.DataFrame(results_secondary)
        output_secondary = os.path.join(output_dir, "secondary_model_regressions.xlsx")
        df_secondary.to_excel(output_secondary, index=False)
        print(f"\n Secondary regression results exported to {output_secondary}")


