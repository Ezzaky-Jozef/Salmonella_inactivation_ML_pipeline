# --- Step 1: Define Helper Functions & Models ---
def calculate_all_metrics(y_true, y_pred, k, n):
    """Calculates all required performance metrics."""
    residuals = y_pred - y_true
    rss = np.sum(residuals**2)
    metrics = {
        'RMSE': np.sqrt(rss / n),
        'R2': r2_score(y_true, y_pred),
        'Bf': 10**(np.mean(residuals)),
        'Af': 10**(np.mean(np.abs(residuals))),
        'AIC': n * np.log(rss / n) + 2 * k if rss > 0 else np.inf,
    }
    return metrics

def weibull_log10_fixedN0(t, delta, p, logN0):
    return logN0 - (t / np.maximum(delta, 1e-12)) ** np.maximum(p, 1e-12)

def biphasic_log10_fixedN0(t, k1, k2, f, logN0):
    f = np.clip(f, 1e-9, 1 - 1e-9)
    k1, k2 = np.maximum(k1, 1e-12), np.maximum(k2, 1e-12)
    A, B = np.log(f) - k1 * t, np.log(1.0 - f) - k2 * t
    return logN0 + (logsumexp(np.vstack([A, B]), axis=0) / np.log(10.0))

def geeraerd_tail_log10_fixedN0(t, k, Nres_counts, logN0):
    k, N0_counts = np.maximum(k, 1e-12), 10.0**logN0
    Nres_counts = np.clip(Nres_counts, 0.0, N0_counts)
    return np.log10(Nres_counts + (N0_counts - Nres_counts) * np.exp(-k * t))

def fit_weibull(t, y, logN0):
    p0 = [max(np.median(t[t > 0]), 1e-2), 1.0]
    popt, _ = curve_fit(lambda tt, d, p: weibull_log10_fixedN0(tt, d, p, logN0), t, y, p0=p0, bounds=([1e-6] * 2, [np.inf] * 2), maxfev=20000)
    return ("delta", "p"), popt, 3

def fit_biphasic(t, y, logN0):
    popt, _ = curve_fit(lambda tt, k1, k2, f: biphasic_log10_fixedN0(tt, k1, k2, f, logN0), t, y, p0=[0.5, 0.05, 0.95], bounds=([1e-6] * 3, [np.inf, np.inf, 1 - 1e-6]), maxfev=50000)
    k1, k2, f = popt
    if k2 > k1: k1, k2, f = k2, k1, 1.0 - f
    return ("k1", "k2", "f"), np.array([k1, k2, f]), 4

def fit_tail(t, y, logN0):
    N0_counts = 10.0**logN0
    popt, _ = curve_fit(lambda tt, k, Nres: geeraerd_tail_log10_fixedN0(tt, k, Nres, logN0), t, y, p0=[0.2, 0.01 * N0_counts], bounds=([1e-6, 0.0], [np.inf, N0_counts]), maxfev=50000)
    return ("k", "Nres_counts"), popt, 3

