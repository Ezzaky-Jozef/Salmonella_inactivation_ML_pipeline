APZ_UPPER = 0.5
APZ_LOWER = -1.0

try:
    validation_df = pd.read_excel('validation_data.xlsx')
    features = ['Time h', 'Oregano %', 'NaCl %', 'pH', 'Temp °C'] 
    X_val = validation_df[features]
    y_val = validation_df['LogN']
    print("\n Validation data loaded and prepared for prediction.")
except FileNotFoundError:
    print("\n ERROR: 'validation_data.xlsx' not found. Please ensure the file is in the correct directory.")
    X_val, y_val = None, None

if X_val is not None:
    best_classical_name = pd.DataFrame(reported_global_results).T.sort_values('AIC').index[0]
    best_ml_name = df_ml_results.index[0]
    
    popt_classical = global_results[best_classical_name]['popt']
    func_classical = global_models[best_classical_name]['func']
    
    y_pred_classical = func_classical(X_val.values.T, *popt_classical)
    y_pred_ml = best_models[best_ml_name].predict(X_val)

    def calculate_papz(observed, predicted):
        residuals = observed - predicted
        count_in_zone = np.sum((residuals >= APZ_LOWER) & (residuals <= APZ_UPPER))
        return (count_in_zone / len(observed)) * 100

    papz_classical = calculate_papz(y_val, y_pred_classical)
    papz_ml = calculate_papz(y_val, y_pred_ml)

    validation_metrics = {
        best_classical_name: calculate_all_metrics(y_val, y_pred_classical, k=len(popt_classical), n=len(y_val)),
        best_ml_name: calculate_all_metrics(y_val, y_pred_ml, k=1, n=len(y_val))
    }
    
    df_validation_summary = pd.DataFrame(validation_metrics).T
    df_validation_summary['pAPZ (%)'] = [papz_classical, papz_ml]
    
    print("\n--- Validation Performance on Real Food Data ---")
    print(df_validation_summary[['RMSE', 'R2', 'Bf', 'Af', 'pAPZ (%)']].round(3))

    with publication_style_bw_minimalist():
        fig, axes = plt.subplots(1, 2, figsize=(14, 6), sharey=True, dpi=100)
        
        all_vals = np.concatenate([y_val, y_pred_classical, y_pred_ml])
        min_lim = np.floor(all_vals.min()) - 1
        max_lim = np.ceil(all_vals.max()) + 1
        line_range = np.linspace(min_lim, max_lim, 100)

        model_preds = [y_pred_classical, y_pred_ml]
        model_names = [best_classical_name, best_ml_name]

        for ax, y_pred, title in zip(axes, model_preds, model_names):
            ax.plot(line_range, line_range, color='black', linestyle='-', linewidth=1.5, label='Identity (y=x)', zorder=2)
            
            ax.fill_between(line_range, line_range + APZ_LOWER, line_range + APZ_UPPER, 
                            color='lightgrey', alpha=0.5, label=f'APZ ({APZ_LOWER}/+{APZ_UPPER})', zorder=1)
            
            residuals = y_val - y_pred
            sd_res = np.std(residuals)
            ax.plot(line_range, line_range + (1.96 * sd_res), color='grey', linestyle='--', linewidth=1, label='95% CI', zorder=2)
            ax.plot(line_range, line_range - (1.96 * sd_res), color='grey', linestyle='--', linewidth=1, zorder=2)

            ax.scatter(y_pred, y_val, color='black', edgecolor='white', s=80, alpha=0.8, zorder=3, label='Validation Data')
            
            ax.set_title(f'{title}\n(pAPZ: {calculate_papz(y_val, y_pred):.1f}%)', fontsize=12, fontweight='bold')
            ax.set_xlabel('Predicted log CFU/g')
            ax.set_xlim(min_lim, max_lim)
            ax.set_ylim(min_lim, max_lim)
            ax.set_aspect('equal')

        axes[0].set_ylabel('Observed log CFU/g')
        axes[0].legend(loc='upper left', fontsize='small', frameon=True)

        plt.tight_layout()
        
        if not os.path.exists(output_dir):
            os.makedirs(output_dir)
            
        plt.savefig(os.path.join(output_dir, 'model_validation_asymmetric_APZ.png'), dpi=300, bbox_inches='tight')
        plt.show()
