# ONE-STEP (GLOBAL) MODELING
# ==============================================================================

if 'df_clean' in locals() and df_clean is not None:
    logN0_global = float(np.nanmax(df_clean['LogN']))
    
    def global_weibull(X, d0, d_o, d_a, d_p, d_t, p0, p_o, p_a, p_p, p_t):
        t, oeo, nacl, ph, temp = X
        delta = d0 + d_o*oeo + d_a*nacl + d_p*ph + d_t*temp
        p = p0 + p_o*oeo + p_a*nacl + p_p*ph + p_t*temp
        return logN0_global - (t / np.maximum(delta, 1e-9))**np.maximum(p, 1e-9)

    def global_biphasic(X, k1_0, k1_o, k1_a, k1_p, k1_t, k2_0, k2_o, k2_a, k2_p, k2_t, f0, f_o, f_a, f_p, f_t):
        t, oeo, nacl, ph, temp = X
        k1 = k1_0 + k1_o*oeo + k1_a*nacl + k1_p*ph + k1_t*temp
        k2 = k2_0 + k2_o*oeo + k2_a*nacl + k2_p*ph + k2_t*temp
        f = np.clip(f0 + f_o*oeo + f_a*nacl + f_p*ph + f_t*temp, 1e-9, 1.0 - 1e-9)
        return logN0_global + np.log10(f * np.exp(-k1 * t) + (1 - f) * np.exp(-k2 * t))

    def global_geeraerd_tail(X, k0, k_o, k_a, k_p, k_t, Nr0, Nr_o, Nr_a, Nr_p, Nr_t):
        t, oeo, nacl, ph, temp = X; N0 = 10**logN0_global
        k_max = k0 + k_o*oeo + k_a*nacl + k_p*ph + k_t*temp
        log_Nres = Nr0 + Nr_o*oeo + Nr_a*nacl + Nr_p*ph + Nr_t*temp
        Nres = np.clip(10**log_Nres, 0.0, N0)
        return np.log10((N0 - Nres) * np.exp(-np.maximum(k_max, 1e-12) * t) + Nres)

    env_factors = ['Oregano %', 'NaCl %', 'pH', 'Temp °C']
    global_models = {
        "Weibull": {"func": global_weibull, "p0": np.zeros(10), "k": 10, "params": [("delta", 5), ("p", 5)]},
        "Biphasic": {"func": global_biphasic, "p0": np.zeros(15), "k": 15, "params": [("k1", 5), ("k2", 5), ("f", 5)]},
        "Geeraerd Tail": {"func": global_geeraerd_tail, "p0": np.zeros(10), "k": 10, "params": [("k_max", 5), ("log_Nres", 5)]}
    }
    X_global = df_clean[['Time h'] + env_factors].values.T
    y_global = df_clean['LogN'].values
    n_points = len(y_global)
    global_results = {}

    for name, model_info in global_models.items():
        print(f"\n--- Fitting Global {name} Model ---")
        try:
            popt, _ = curve_fit(model_info["func"], X_global, y_global, p0=model_info["p0"], maxfev=50000)
            y_pred = model_info["func"](X_global, *popt)
            metrics = calculate_all_metrics(y_global, y_pred, model_info["k"], n_points)
            global_results[name] = {"y_pred": y_pred, "popt": popt, **metrics}
        except Exception as e:
            print(f"Could not fit global {name} model. Error: {e}")
            global_results[name] = {"y_pred": None, "popt": None, "RMSE": np.nan, "R2": np.nan, "Bf": np.nan, "Af": np.nan, "AIC": np.nan}

    # Geeraerd excluded from reporting due to poor parameter identifiability (Section 3.2)
    reported_global_models = {k: v for k, v in global_models.items() if k != "Geeraerd Tail"}
    reported_global_results = {k: v for k, v in global_results.items() if k != "Geeraerd Tail"}

    with publication_style_bw_minimalist():
        fig, axes = plt.subplots(1, len(reported_global_results), figsize=(12, 5.5), sharey=True)
        line_range = np.array([-1, 8])

        for i, (name, results) in enumerate(reported_global_results.items()):
            ax = axes[i]
            if results['y_pred'] is not None:
                ax.plot(results['y_pred'], y_global, 'o', color='black', markersize=4, alpha=0.6)
                ax.plot(line_range, line_range, color='black', linestyle='-', linewidth=1.5, label='y=x')
                ax.plot(line_range + 0.5, line_range, color='red', linestyle='--', linewidth=1.5, label='APZ')
                ax.plot(line_range - 1.0, line_range, color='red', linestyle='--', linewidth=1.5)
                ax.set_title(f'{name}\n(AIC={results["AIC"]:.1f})')
            else:
                ax.set_title(f'{name}\n(Fit Failed)')
            ax.set_xlabel('Predicted log CFU/g'); ax.set_xlim(-0.5, 7.5); ax.set_ylim(-0.5, 7.5)
            if i == 0: ax.legend()
        axes[0].set_ylabel('Observed log CFU/g')

        fig_filename = os.path.join(output_dir, 'global_models_parity_plots_with_APZ.png')
        plt.tight_layout(); plt.savefig(fig_filename, dpi=300, bbox_inches='tight')
        plt.show()

    equations_filename = os.path.join(output_dir, 'global_model_equations.txt')
    with open(equations_filename, 'w') as f:
        f.write("SECONDARY MODEL EQUATIONS FROM ONE-STEP GLOBAL FIT\n" + "="*60 + "\n")
        for name, results in global_results.items():
            f.write(f"\n--- Equations for Global {name} Model ---\n")
            if results['popt'] is not None:
                model_info, popt, param_idx = global_models[name], results['popt'], 0
                for param_name, num_coeffs in model_info['params']:
                    intercept, coeffs = popt[param_idx], popt[param_idx+1:param_idx+num_coeffs]
                    equation = f"{param_name} = {intercept:+.4f} " + " ".join([f"{'-' if c < 0 else '+'} {abs(c):.4f}*[{fac}]" for fac, c in zip(env_factors, coeffs)])
                    f.write(f"\n{equation}\n")
                    param_idx += num_coeffs
            else:
                f.write("Fit failed, cannot generate equations.\n")
    print(f"\n---  Global model equations exported to '{equations_filename}' ---")


