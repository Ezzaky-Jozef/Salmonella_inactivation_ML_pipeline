if 'df_clean' in locals() and df_clean is not None:
    print("\n--- Performing Group-Based (by Run-ID) Train-Test Split for ML Models ---")
    features = ['Time h', 'Oregano %', 'NaCl %', 'pH', 'Temp °C']
    target = 'LogN'
    X, y = df_clean[features], df_clean[target]
    groups = df_clean['Run-ID']

    gss = GroupShuffleSplit(n_splits=1, test_size=0.25, random_state=42)
    train_idx, test_idx = next(gss.split(X, y, groups=groups))

    X_train, X_test = X.iloc[train_idx], X.iloc[test_idx].copy()
    y_train, y_test = y.iloc[train_idx], y.iloc[test_idx]

    X_test['Run-ID'] = df_clean.loc[X_test.index, 'Run-ID']

    print(f"Split data into {len(X_train)} rows for training and {len(X_test)} rows for testing.")
    print(f"Training Run-IDs: {sorted(groups.iloc[train_idx].unique())}")
    print(f"Testing Run-IDs:  {sorted(groups.iloc[test_idx].unique())}")

    print("\n--- Starting Hyperparameter Tuning for ML Models ---")
    grid_search_rf = GridSearchCV(RandomForestRegressor(random_state=42), {'n_estimators':[100,200],'max_depth':[10,20]}, cv=5, n_jobs=-1).fit(X_train, y_train)
    best_rf = grid_search_rf.best_estimator_
    
    grid_search_xgb = GridSearchCV(xgb.XGBRegressor(objective='reg:squarederror', random_state=42), {'n_estimators':[100,200],'max_depth':[3,5]}, cv=5, n_jobs=-1).fit(X_train, y_train)
    best_xgb = grid_search_xgb.best_estimator_

    ml_results = {}
    best_models = {'Tuned Random Forest': best_rf, 'Tuned XGBoost': best_xgb}
    
    for name, model in best_models.items():
        y_pred = model.predict(X_test.drop('Run-ID', axis=1))
        ml_results[name] = {**calculate_all_metrics(y_test, y_pred, 1, len(y_test)), 'y_pred': y_pred}

    df_ml_results = pd.DataFrame(ml_results).T.sort_values('RMSE')
    ml_metrics_filename = os.path.join(output_dir, 'ml_model_performance_metrics.xlsx')
    df_ml_results[['RMSE','R2','Bf','Af']].round(4).to_excel(ml_metrics_filename)
    print(f"\n---  ML Metrics Exported to '{ml_metrics_filename}' ---")
    print(df_ml_results[['RMSE','R2','Bf','Af']].round(4))
    
    print("\n--- Generating ML Model Comparison Parity Plot ---")
    with publication_style_bw_minimalist():
        models_to_plot = ['Tuned Random Forest', 'Tuned XGBoost']
        fig, axes = plt.subplots(1, 2, figsize=(14, 6), sharey=True)
        panel_labels = iter(string.ascii_lowercase)
        line_range = np.array([0, 7])

        for i, model_name in enumerate(models_to_plot):
            if model_name not in ml_results:
                print(f"Warning: Model '{model_name}' not in results. Skipping plot.")
                continue

            ax = axes[i]
            results = ml_results[model_name]
            y_pred = results['y_pred']
            rmse = results['RMSE']
            
            ax.plot(y_pred, y_test, 'o', color='0.3', markersize=5, alpha=0.8)
            identity_line, = ax.plot(line_range, line_range, color='black', linestyle='-', linewidth=2, label='y=x')
            apz_upper_line, = ax.plot(line_range, line_range + 0.5, color='red', linestyle='--', linewidth=2, label='APZ')
            ax.plot(line_range, line_range - 1.0, color='red', linestyle='--', linewidth=2)
            ax.set_title(f'{model_name}\n(RMSE={rmse:.2f})')
            ax.set_xlabel('Predicted viable counts (log cfu/g)')
            ax.set_xlim(line_range); ax.set_ylim(line_range)
            ax.text(0.05, 0.95, f"({next(panel_labels)})", transform=ax.transAxes, fontsize=16, fontweight='bold', va='top')

        axes[0].set_ylabel('Observed viable counts (log cfu/g)')
        axes[0].legend(handles=[identity_line, apz_upper_line], labels=['y=x', 'APZ'])
        plt.tight_layout()
        fig_filename = os.path.join(output_dir, 'ml_models_parity_plot_comparison.png')
        plt.savefig(fig_filename, dpi=300, bbox_inches='tight')
        plt.show()

    print("\n--- Generating Time-Series Scatter Comparison Plots ---")
    if 'global_weibull' in locals() and 'Weibull' in global_results:
        popt_weibull = global_results['Weibull']['popt']
        y_pred_weibull = global_weibull(X_test.drop('Run-ID', axis=1).values.T, *popt_weibull)
        
        y_pred_rf = ml_results['Tuned Random Forest']['y_pred']
        y_pred_xgb = ml_results['Tuned XGBoost']['y_pred']

        plot_df = X_test.copy()
        plot_df['Observed'] = y_test
        plot_df['Weibull'] = y_pred_weibull
        plot_df['Tuned Random Forest'] = y_pred_rf
        plot_df['Tuned XGBoost'] = y_pred_xgb

        run_ids_to_plot = [] 

        all_test_run_ids = plot_df['Run-ID'].unique()
        
        if not run_ids_to_plot:
