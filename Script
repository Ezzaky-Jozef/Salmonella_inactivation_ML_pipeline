        for run_id in run_ids_to_plot:
            if run_id not in all_test_run_ids:
                print(f"Warning: Run-ID {run_id} is not in the test set. Skipping.")
                continue

            run_data = plot_df[plot_df['Run-ID'] == run_id].sort_values('Time h')
            
            with publication_style_bw_minimalist():
                fig, ax = plt.subplots(figsize=(8, 6))

                ax.plot(run_data['Time h'], run_data['Observed'], 
                        marker='o', color='grey', markersize=8, linestyle='None', label='Observed')
                ax.plot(run_data['Time h'], run_data['Tuned Random Forest'], 
                        marker='^', color='black', markersize=8, linestyle='None', markerfacecolor='none', label='Tuned Random Forest')
                ax.plot(run_data['Time h'], run_data['Tuned XGBoost'],
                        marker='D', color='black', markersize=7, linestyle='None', markerfacecolor='none', label='Tuned XGBoost')
                ax.plot(run_data['Time h'], run_data['Weibull'],
                        marker='s', color='black', markersize=8, linestyle='None', label='Weibull')

                ax.set_xlabel('Time (hours)')
                ax.set_ylabel('Viable counts (log cfu/g)')
                ax.legend()
                ax.set_title(f'Model Comparison for Run-ID: {run_id}')
                
                fig_filename = os.path.join(output_dir, f'scatter_comparison_run_{run_id}.png')
                plt.savefig(fig_filename, dpi=300, bbox_inches='tight')
                plt.show()
    else:
        print("Could not generate scatter comparison plots. Global Weibull model results not found.")

    best_ml_model_name = df_ml_results.index[0]
    if best_ml_model_name in best_models:
        print(f"\n--- Generating Feature Importance for the Best Model: {best_ml_model_name} ---")
